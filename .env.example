# ==============================================================================
# CUBiO AI — Production Environment Configuration Template
# .env.example
# ==============================================================================

# Node Runtime Environment (development | staging | production | test)
NODE_ENV=production
CUBIO_ENV=production

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
CUBIO_API_BASE_URL=https://api.cubio.ai

# Cross-Origin Resource Sharing (CORS) — Comma-separated allowed origins
CUBIO_CORS_ORIGINS=https://cubio.ai,https://studio.cubio.ai

# Authentication & API Keys (Comma-separated keys and roles: admin, user, readonly)
# Required in production. Never commit production keys to git.
CUBIO_API_KEYS=prod_admin_key_replace_with_secure_random,prod_user_key_replace_with_secure_random
CUBIO_API_KEY_ROLES=admin,user
CUBIO_API_AUTH_DISABLED=false

# Commercial Billing & Webhooks (Polar / Provider)
CUBIO_WEBHOOK_SECRET=whsec_replace_with_polar_webhook_secret_at_least_32_chars
CUBIO_BILLING_PROVIDER_URL=https://checkout.polar.sh
CUBIO_BILLING_GRACE_PERIOD_DAYS=3

# Database & Persistent Storage (SQLite WAL)
CUBIO_DB_PATH=data/cubio_studio.db
CUBIO_DB_WAL=true
CUBIO_DB_BUSY_TIMEOUT_MS=5000

# Safety & Architectural Constraints (Permanently Locked — Do Not Change)
CUBIO_ALLOW_ACTUATION=false
CUBIO_ENABLE_NEURAL_PRIMARY=false

# Operational Limits & Concurrency Governors
CUBIO_MAX_CONCURRENT=32
CUBIO_REQUEST_TIMEOUT_MS=30000
CUBIO_MAX_PAYLOAD_BYTES=65536
CUBIO_RATE_LIMIT_PER_MINUTE=120

# Observability, Structured Logging & Security Audit
CUBIO_AUDIT_LOG_PATH=data/api_audit.log
CUBIO_LOG_LEVEL=info
CUBIO_MAX_LOG_SIZE_BYTES=10485760
